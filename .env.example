# ============================================================
# Variables de Entorno — LMS LegalTech (EJEMPLO)
# Copiar a .env (nunca versionar .env) y completar con valores reales.
# Todos los valores de este archivo son FICTICIOS.
# ============================================================

# ---- Perfil de Spring ----
SPRING_PROFILES_ACTIVE=production

# ---- PostgreSQL (OBLIGATORIO) ----
DB_URL=jdbc:postgresql://localhost:5432/lms_db
DB_USERNAME=lms_user
DB_PASSWORD=cambiar_esto
# Equivalentes usados por docker compose
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=cambiar_esto
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lms_db
SPRING_DATASOURCE_USERNAME=lms_user
SPRING_DATASOURCE_PASSWORD=cambiar_esto

# ---- JWT (OBLIGATORIO) ----
# Generar con: openssl rand -base64 64
JWT_SECRET=cambiar_esto_por_un_secreto_de_64_bytes

# ---- Redis (OPCIONAL — necesario para exportaciones asíncronas) ----
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Almacenamiento de objetos S3/MinIO (OPCIONAL) ----
# Compatible con MinIO, Backblaze B2, Cloudflare R2, etc.
B2_ENDPOINT=http://localhost:9000
B2_KEY_ID=cambiar_esto
B2_APP_KEY=cambiar_esto
B2_BUCKET_NAME=lms-archivos
# Equivalentes usados por docker compose
MINIO_ROOT_USER=lms_admin
MINIO_ROOT_PASSWORD=cambiar_esto
APP_MINIO_ENDPOINT=http://localhost:9000
APP_MINIO_ACCESS_KEY=cambiar_esto
APP_MINIO_SECRET_KEY=cambiar_esto
APP_MINIO_BUCKET_NAME=lms-archivos

# ---- Mail (OPCIONAL) ----
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Notificaciones de brecha ----
BREACH_NOTIFICATION_EMAIL=dpo@example.com

# ---- Clave de cifrado en reposo (producción) ----
CIFRADO_SECRET_KEY=cambiar_esto_por_una_clave_de_32_bytes

# ---- Cookies / SSL ----
COOKIE_SECURE=false
SSL_ENABLED=false

# ---- Usuarios semilla (solo desarrollo/demo) ----
# Si no se definen, el sistema usa contraseñas de demostración fijas.
SEED_ADMIN_PASSWORD=Demo1234!
SEED_INSTRUCTOR_PASSWORD=Demo1234!
SEED_ESTUDIANTE_PASSWORD=Demo1234!
